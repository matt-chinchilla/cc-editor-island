(kicad_wks (version 20231118) (generator "pl_editor")
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (name "") (start 110 34) (end 2 2))
  (line (name "") (start 50 2) (end 50 0))
  (tbtext "kept" (name "") (pos 30 10))
  (tbtext "unclosed" (name "") (pos 30 20)
  (line (name "after") (start 1 1) (end 2 2))
)
