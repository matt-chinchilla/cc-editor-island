{
  "name": "cc-editor-island",
  "version": "0.0.0",
  "description": "The editor island served on editor.circuitcenter.ai: PCBJam's pinned KiCad engine, our loader and the cc-editor/1 responder",
  "scripts": {
    "test": "vitest run",
    "sync-upstream": "node scripts/sync-upstream.mjs",
    "fetch-engine": "node scripts/fetch-engine.mjs",
    "build": "node scripts/build.mjs",
    "build:local": "node scripts/build.mjs --local",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "notices": "node scripts/notices.mjs",
    "gen:pencil-tools": "node theme/pencil-tools.gen.mjs",
    "ship": "bash scripts/ship.sh",
    "build:libs": "node scripts/build-libs.mjs --out dist/libs",
    "ship:libs": "bash scripts/ship-libs.sh"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
